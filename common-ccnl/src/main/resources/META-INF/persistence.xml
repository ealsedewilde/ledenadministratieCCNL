<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
	version="3.0">
	<persistence-unit name="nl.ealse.ccnl.leden">
	
		<class>nl.ealse.ccnl.ledenadministratie.model.ArchivedMember</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.DirectDebitConfig</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.Document</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.DocumentTemplate</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.ExternalRelation</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.ExternalRelationClub</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.ExternalRelationOther</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.ExternalRelationPartner</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.InternalRelation</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.Member</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.PaymentFile</class>
		<class>nl.ealse.ccnl.ledenadministratie.model.Setting</class>

		<properties>
			<property name="jakarta.persistence.schema-generation.database.action" value="none" />
			<property name="hibernate.physical_naming_strategy"
				value="org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy" />

			<property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver" />
			<property name="hibernate.connection.provider_class"
				value="nl.ealse.ccnl.ledenadministratie.h2.JdbcConnectionPoolProvider" />
			<property name="hibernate.connection.pool_size"	value="5"/>
			<!-- <property name="jakarta.persistence.schema-generation.scripts.action" value="drop-and-create" 
				/> <property name="jakarta.persistence.schema-generation.scripts.create-target" value="./create.sql" 
				/> -->
			<!-- Echo all executed SQL to console -->
			<!-- <property name="hibernate.show_sql" value="true" /> <property name="hibernate.format_sql" value="true" 
				/> <property name="hibernate.highlight_sql" value="true" /> -->
		</properties>
	</persistence-unit>
</persistence> 